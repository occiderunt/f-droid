{"repo": {"timestamp": 1795558472000, "version": 20002, "name": "Occiderunt", "icon": "icon.png", "address": "https://occiderunt.github.io/f-droid/repo", "description": "Android releases of Occiderunt apps, built and signed by Occiderunt. Bling is peer-to-peer chat with no server in the middle; Poirot is a pantry ledger."}, "requests": {"install": [], "uninstall": []}, "apps": [{"authorName": "Occiderunt", "authorWebSite": "https://occiderunt.github.io/bling/", "categories": ["Internet", "Communication"], "changelog": "https://github.com/occiderunt/bling/releases", "suggestedVersionCode": "1003000", "description": "Bling is a chat app that connects directly to the other people you are\ntalking to. There is no account, no sign-up and no relay server: messages\ntravel over a libp2p swarm between the devices themselves.\n\nHow it works:\n\n* Your identity is a key pair generated on the device and stored locally.\n* Peers find each other on the local network, or you paste an invite address\n  to connect across networks.\n* Each room is a gossipsub topic, so everyone in the room sees the same\n  messages.\n\nThings worth knowing:\n\n* Rooms are open to anyone who knows the room name.\n* History is kept on the device only, and the last 300 messages per room are\n  kept.\n* On Android 17 and later, the app asks for local network access so it can\n  reach peers on your Wi-Fi.\n* Notifications only appear when the app is in the background.\n* Nothing is stored on a server, because there is no server.\n\nBling is free software under the MIT license.\n", "issueTracker": "https://github.com/occiderunt/bling/issues", "license": "MIT", "name": "Bling", "sourceCode": "https://github.com/occiderunt/bling", "summary": "Peer-to-peer chat with no server in the middle", "webSite": "https://occiderunt.github.io/bling/", "added": 1795443739000, "packageName": "org.vellum.bling", "lastUpdated": 1795458623000, "localized": {"en-US": {"icon": "icon_flPQmWg69blgII7V3_glc1zKnbDjhkcBps_uYD3hKvE=.png"}}}, {"authorName": "NET Study", "authorWebSite": "https://net-study.github.io/netstudy-synopsis/", "categories": ["Reading"], "changelog": "https://github.com/NET-Study/netstudy-synopsis/releases", "suggestedVersionCode": "1001002", "description": "A synopsis of the four Gospels for reading and study. Rather than\nblending the accounts into one harmony, it keeps each Evangelist in\nhis own column, in his own order, over the standard pericope\nsequence.\n\nOn a phone the columns become a swipeable strip: one Gospel fills the\nscreen, the tabs above jump between Matthew, Mark, Luke and John, and\nthe outline lives in a drawer behind the menu button. Tapping a verse\npins it and opens its closest wording in the other Gospels; tapping a\nparallel jumps to that Gospel at the matching verse.\n\nPassage text is the NET Bible, fetched from the NET Bible API and\ncached on the device for offline reading. Scripture quotations are\ncopyright Biblical Studies Press, L.L.C., and are used by permission.\n\nThe app is free software under the GNU GPL v3.\n", "issueTracker": "https://github.com/NET-Study/netstudy-synopsis/issues", "license": "GPL-3.0-only", "name": "NET Study Synopsis", "sourceCode": "https://github.com/NET-Study/netstudy-synopsis", "summary": "The four Gospels side by side, one screen at a time", "webSite": "https://net-study.github.io/netstudy-synopsis/", "added": 1795456760000, "packageName": "org.vellum.netstudysynopsis", "lastUpdated": 1795456760000, "localized": {"en-US": {"icon": "icon_YAjhgpsJyweS9PV_2Vb0vVjKU4ENNS1rYDw67mDTGgw=.png"}}}, {"authorName": "Occiderunt", "categories": ["Household"], "changelog": "https://github.com/occiderunt/poirot/releases", "suggestedVersionCode": "1000001", "description": "Poirot keeps track of what is in your pantry: how much is left, when it\nneeds using, and which shelf it lives on.\n\nShelves are yours to name and recolour: Left Pantry, Fridge, Freezer,\nSpice Rack, or anything else. Items carry a quantity with a sensible\nunit, an optional expiry date and an optional low-stock threshold. The\nhome screen surfaces anything expiring soon, running low or already out,\nand one searchable list holds every item with filters for the same.\n\nA JSON backup copies the whole pantry to a file and restores it on\nanother device.\n\nEverything stays on the device. No account, no network, no sync.\nPoirot is free software under the MIT license.\n", "issueTracker": "https://github.com/occiderunt/poirot/issues", "license": "MIT", "name": "Poirot", "sourceCode": "https://github.com/occiderunt/poirot", "summary": "A pantry ledger for what is on your shelves", "webSite": "https://github.com/occiderunt/poirot", "added": 1795557468000, "packageName": "org.vellum.poirot", "lastUpdated": 1795558472000, "localized": {"en-US": {"icon": "icon_W0CSlzVW_OJ5RUVkNgsshANmVAbSk3qmZfy1LtgjBTM=.png"}}}], "packages": {"org.vellum.bling": [{"added": 1795458623000, "apkName": "org.vellum.bling_1003000.apk", "hash": "0d0bdf3891939cad0219fb1e246d499a32d12fa3c6b40be05ce42e6ecc86b92e", "hashType": "sha256", "minSdkVersion": 24, "nativecode": ["arm64-v8a"], "packageName": "org.vellum.bling", "sig": "b77c23ca666ca0595f09df402ca06f6d", "signer": "f0cf66b50c5fae703a83d7bf8de7d15f786106e4bd2f61da6ab2d9ab836de653", "size": 12092247, "targetSdkVersion": 37, "uses-permission": [["android.permission.INTERNET", null], ["android.permission.POST_NOTIFICATIONS", null], ["android.permission.ACCESS_LOCAL_NETWORK", null], ["android.permission.CAMERA", null], ["android.permission.VIBRATE", null], ["android.permission.RECEIVE_BOOT_COMPLETED", null], ["android.permission.WAKE_LOCK", null], ["org.vellum.bling.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION", null], ["android.permission.ACCESS_NETWORK_STATE", null]], "versionCode": 1003000, "versionName": "1.3.0"}, {"added": 1795450311000, "apkName": "org.vellum.bling_1002000.apk", "hash": "654b944bd540f50ce1315313472cc8e229b0db49f5806c0cd16ba7de877bed9d", "hashType": "sha256", "minSdkVersio