{"repo": {"description": {"en-US": "Android releases of Occiderunt apps, built and signed by Occiderunt. Bling is peer-to-peer chat with no server in the middle; Poirot is a pantry ledger."}, "timestamp": 1795558472000, "categories": {"Household": {"name": {"en-US": "Household"}}}}, "packages": {"org.vellum.bling": {"metadata": {"icon": {"en-US": {"name": "/org.vellum.bling/en-US/icon_flPQmWg69blgII7V3_glc1zKnbDjhkcBps_uYD3hKvE=.png", "sha256": "7e53d099683af5b960208ed5dff825735cca9db0e3864701a6cfee603de12af1", "size": 101830}}}}, "org.vellum.netstudysynopsis": {"metadata": {"icon": {"en-US": {"name": "/org.vellum.netstudysynopsis/en-US/icon_YAjhgpsJyweS9PV_2Vb0vVjKU4ENNS1rYDw67mDTGgw=.png", "sha256": "6008e1829b09cb0792f4f57fd956f4bd58ca53810d352d6b603c3aee60d31a0c", "size": 128925}}}}, "org.vellum.poirot": {"metadata": {"added": 1795557468000, "categories": ["Household"], "changelog": "https://github.com/occiderunt/poirot/releases", "issueTracker": "https://github.com/occiderunt/poirot/issues", "lastUpdated": 1795558472000, "license": "MIT", "sourceCode": "https://github.com/occiderunt/poirot", "webSite": "https://github.com/occiderunt/poirot", "authorName": "Occiderunt", "name": {"en-US": "Poirot"}, "summary": {"en-US": "A pantry ledger for what is on your shelves"}, "description": {"en-US": "Poirot keeps track of what is in your pantry: how much is left, when it\nneeds using, and which shelf it lives on.\n\nShelves are yours to name and recolour: Left Pantry, Fridge, Freezer,\nSpice Rack, or anything else. Items carry a quantity with a sensible\nunit, an optional expiry date and an optional low-stock threshold. The\nhome screen surfaces anything expiring soon, running low or already out,\nand one searchable list holds every item with filters for the same.\n\nA JSON backup copies the whole pantry to a file and restores it on\nanother device.\n\nEverything stays on the device. No account, no network, no sync.\nPoirot is free software under the MIT license.\n"}, "icon": {"en-US": {"name": "/org.vellum.poirot/en-US/icon_W0CSlzVW_OJ5RUVkNgsshANmVAbSk3qmZfy1LtgjBTM=.png", "sha256": "5b4092973556fce279454564360b2c8403665406d2937aa665fcb52ed8230533", "size": 37502}}, "preferredSigner": "7c646b116a315ae16247080d42a78a351e99a81b71c82ac542b48428a14e23d5"}, "versions": {"f5f459fc41fe9530c2aecd679198ceac904f85b3f621905b28919170060d715e": {"added": 1795558472000, "file": {"name": "/org.vellum.poirot_1000001.apk", "sha256": "f5f459fc41fe9530c2aecd679198ceac904f85b3f621905b28919170060d715e", "size": 5943902}, "manifest": {"nativecode": ["arm64-v8a"], "versionName": "1.0.1", "versionCode": 1000001, "usesSdk": {"minSdkVersion": 24, "targetSdkVersion": 37}, "signer": {"sha256": ["7c646b116a315ae16247080d42a78a351e99a81b71c82ac542b48428a14e23d5"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "org.vellum.poirot.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}, "834258ac17fe8d727dab454c6f92820f0bc8df86ed5f764ee658525f6732cfe7": {"added": 1795557468000, "file": {"name": "/org.vellum.poirot_1000000.apk", "sha256": "834258ac17fe8d727dab454c6f92820f0bc8df86ed5f764ee658525f6732cfe7", "size": 5886914}, "manifest": {"nativecode": ["arm64-v8a"], "versionName": "1.0.0", "versionCode": 1000000, "usesSdk": {"minSdkVersion": 24, "targetSdkVersion": 37}, "signer": {"sha256": ["7c646b116a315ae16247080d42a78a351e99a81b71c82ac542b48428a14e23d5"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "org.vellum.poirot.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}}}