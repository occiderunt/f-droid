{"repo": {"description": {"en-US": "Android releases of Occiderunt apps, built and signed by Occiderunt. Bling is peer-to-peer chat with no server in the middle; Poirot is a pantry ledger."}, "timestamp": 1795557475000, "categories": {"Household": {"name": {"en-US": "Household"}}, "Reading": {"name": {"en-US": "Reading"}}}}, "packages": {"org.vellum.bling": {"metadata": {"lastUpdated": 1795458623000}, "versions": {"6c6370450a25d13978ce8f6c7baf6e7f0b52fdd086b9e5f9182ffa93ba7bf410": null, "0d0bdf3891939cad0219fb1e246d499a32d12fa3c6b40be05ce42e6ecc86b92e": {"added": 1795458623000, "file": {"name": "/org.vellum.bling_1003000.apk", "sha256": "0d0bdf3891939cad0219fb1e246d499a32d12fa3c6b40be05ce42e6ecc86b92e", "size": 12092247}, "manifest": {"nativecode": ["arm64-v8a"], "versionName": "1.3.0", "versionCode": 1003000, "usesSdk": {"minSdkVersion": 24, "targetSdkVersion": 37}, "signer": {"sha256": ["f0cf66b50c5fae703a83d7bf8de7d15f786106e4bd2f61da6ab2d9ab836de653"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.ACCESS_LOCAL_NETWORK"}, {"name": "android.permission.CAMERA"}, {"name": "android.permission.VIBRATE"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "org.vellum.bling.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}]}}, "654b944bd540f50ce1315313472cc8e229b0db49f5806c0cd16ba7de877bed9d": {"added": 1795450311000, "file": {"name": "/org.vellum.bling_1002000.apk", "sha256": "654b944bd540f50ce1315313472cc8e229b0db49f5806c0cd16ba7de877bed9d", "size": 12075863}, "manifest": {"nativecode": ["arm64-v8a"], "versionName": "1.2.0", "versionCode": 1002000, "usesSdk": {"minSdkVersion": 24, "targetSdkVersion": 37}, "signer": {"sha256": ["f0cf66b50c5fae703a83d7bf8de7d15f786106e4bd2f61da6ab2d9ab836de653"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.ACCESS_LOCAL_NETWORK"}, {"name": "android.permission.CAMERA"}, {"name": "android.permission.VIBRATE"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "org.vellum.bling.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}]}}}}, "org.vellum.netstudysynopsis": {"metadata": {"added": 1795456760000, "categories": ["Reading"], "changelog": "https://github.com/NET-Study/netstudy-synopsis/releases", "issueTracker": "https://github.com/NET-Study/netstudy-synopsis/issues", "lastUpdated": 1795456760000, "license": "GPL-3.0-only", "sourceCode": "https://github.com/NET-Study/netstudy-synopsis", "webSite": "https://net-study.github.io/netstudy-synopsis/", "authorName": "NET Study", "authorWebSite": "https://net-study.github.io/netstudy-synopsis/", "name": {"en-US": "NET Study Synopsis"}, "summary": {"en-US": "The four Gospels side by side, one screen at a time"}, "description": {"en-US": "A synopsis of the four Gospels for reading and study. Rather than\nblending the accounts into one harmony, it keeps each Evangelist in\nhis own column, in his own order, over the standard pericope\nsequence.\n\nOn a phone the columns become a swipeable strip: one Gospel fills the\nscreen, the tabs above jump between Matthew, Mark, Luke and John, and\nthe outline lives in a drawer behind the menu button. Tapping a verse\npins it and opens its closest wording in the other Gospels; tapping a\nparallel jumps to that Gospel at the matching verse.\n\nPassage text is the NET Bible, fetched from the NET Bible API and\ncached on the device for offline reading. Scripture quotations are\ncopyright Biblical Studies Press, L.L.C., and are used by permission.\n\nThe app is free software under the GNU GPL v3.\n"}, "preferredSigner": "f87a36904a6f3733249737ed46cea023e170ccfbefc4f6e892100a02b22439e8"}, "versions": {"3fd613aacfbaa2a15041e79b54efb02df670feece1281f6a482273169b9db6c1": {"added": 1795456760000, "file": {"name": "/org.vellum.netstudysynopsis_1001002.apk", "sha256": "3fd613aacfbaa2a15041e79b54efb02df670feece1281f6a482273169b9db6c1", "size": 7543761}, "manifest": {"nativecode": ["arm64-v8a"], "versionName": "1.1.2", "versionCode": 1001002, "usesSdk": {"minSdkVersion": 24, "targetSdkVersion": 37}, "signer": {"sha256": ["f87a36904a6f3733249737ed46cea023e170ccfbefc4f6e892100a02b22439e8"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "org.vellum.netstudysynopsis.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "org.vellum.poirot": {"metadata": {"added": 1795557468000, "categories": ["Household"], "changelog": "https://github.com/occiderunt/poirot/releases", "issueTracker": "https://github.com/occiderunt/poirot/issues", "lastUpdated": 1795557468000, "license": "MIT", "sourceCode": "https://github.com/occiderunt/poirot", "webSite": "https://github.com/occiderunt/poirot", "authorName": "Occiderunt", "name": {"en-US": "Poirot"}, "summary": {"en-US": "A pantry ledger for what is on your shelves"}, "description": {"en-US": "Poirot keeps track of what is in your pantry: how much is left, when it\nneeds using, and which shelf it lives on.\n\nShelves are yours to name and recolour: Left Pantry, Fridge, Freezer,\nSpice Rack, or anything else. Items carry a quantity with a sensible\nunit, an optional expiry date and an optional low-stock threshold. The\nhome screen surfaces anything expiring soon, running low or already out,\nand one searchable list holds every item with filters for the same.\n\nA JSON backup copies the whole pantry to a file and restores it on\nanother device.\n\nEverything stays on the device. No account, no network, no sync.\nPoirot is free software under the MIT license.\n"}, "preferredSigner": "7c646b116a315ae16247080d42a78a351e99a81b71c82ac542b48428a14e23d5"}, "versions": {"834258ac17fe8d727dab454c6f92820f0bc8df86ed5f764ee658525f6732cfe7": {"added": 1795557468000, "file": {