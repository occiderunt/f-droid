{"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.ACCESS_LOCAL_NETWORK"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "org.vellum.bling.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "org.vellum.netstudysynopsis": {"metadata": {"added": 1795456760000, "categories": ["Reading"], "changelog": "https://github.com/NET-Study/netstudy-synopsis/releases", "issueTracker": "https://github.com/NET-Study/netstudy-synopsis/issues", "lastUpdated": 1795456760000, "license": "GPL-3.0-only", "sourceCode": "https://github.com/NET-Study/netstudy-synopsis", "webSite": "https://net-study.github.io/netstudy-synopsis/", "authorName": "NET Study", "authorWebSite": "https://net-study.github.io/netstudy-synopsis/", "name": {"en-US": "NET Study Synopsis"}, "summary": {"en-US": "The four Gospels side by side, one screen at a time"}, "description": {"en-US": "A synopsis of the four Gospels for reading and study. Rather than\nblending the accounts into one harmony, it keeps each Evangelist in\nhis own column, in his own order, over the standard pericope\nsequence.\n\nOn a phone the columns become a swipeable strip: one Gospel fills the\nscreen, the tabs above jump between Matthew, Mark, Luke and John, and\nthe outline lives in a drawer behind the menu button. Tapping a verse\npins it and opens its closest wording in the other Gospels; tapping a\nparallel jumps to that Gospel at the matching verse.\n\nPassage text is the NET Bible, fetched from the NET Bible API and\ncached on the device for offline reading. Scripture quotations are\ncopyright Biblical Studies Press, L.L.C., and are used by permission.\n\nThe app is free software under the GNU GPL v3.\n"}, "preferredSigner": "f87a36904a6f3733249737ed46cea023e170ccfbefc4f6e892100a02b22439e8"}, "versions": {"3fd613aacfbaa2a15041e79b54efb02df670feece1281f6a482273169b9db6c1": {"added": 1795456760000, "file": {"name": "/org.vellum.netstudysynopsis_1001002.apk", "sha256": "3fd613aacfbaa2a15041e79b54efb02df670feece1281f6a482273169b9db6c1", "size": 7543761}, "manifest": {"nativecode": ["arm64-v8a"], "versionName": "1.1.2", "versionCode": 1001002, "usesSdk": {"minSdkVersion": 24, "targetSdkVersion": 37}, "signer": {"sha256": ["f87a36904a6f3733249737ed46cea023e170ccfbefc4f6e892100a02b22439e8"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "org.vellum.netstudysynopsis.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}}}